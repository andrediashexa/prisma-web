{
	# Plain HTTP for now. For HTTPS, replace ":80" with the domain (or ":443")
	# and remove this line; also set COOKIE_SECURE=true on the back end.
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy back:8000
	}

	handle {
		reverse_proxy front:3000
	}
}
