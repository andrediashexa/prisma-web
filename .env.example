# Copie para .env e ajuste. O .env nunca deve ser commitado.

# Porta HTTP publicada no host (IPv4 e IPv6).
HTTP_PORT=80

# Banco de dados.
POSTGRES_USER=prisma
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prisma_web

# Administrador criado na primeira subida (banco vazio).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória aparece em `docker compose logs back`.
# Em ambos os casos a troca de senha é exigida no primeiro acesso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Chave que cifra os tokens dos roteadores no banco. Gere com: openssl rand -base64 32
# Se mudar, os tokens salvos deixam de funcionar e precisam ser recadastrados.
APP_SECRET_KEY=

# Prismas simulados para desenvolvimento (remova "mock" quando usar só roteadores reais).
COMPOSE_PROFILES=mock
# Opcional: Prisma cadastrado automaticamente na primeira subida. Os demais, pela interface.
PRISMA_API_URL=http://prisma-mock:8080
PRISMA_API_TOKEN=

SESSION_TTL_HOURS=12
# Mude para true quando o acesso for por HTTPS.
COOKIE_SECURE=false
