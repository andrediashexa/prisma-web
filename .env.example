# Copy to .env and adjust. Never commit .env.

# HTTP port published on the host (IPv4 and IPv6).
HTTP_PORT=80

# Database.
POSTGRES_USER=prisma
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=prisma_web

# Administrator created on first start (empty database).
# If ADMIN_PASSWORD is empty, a random password shows up in `docker compose logs back`.
# Either way, a password change is required on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Simulated Prismas for development (remove "mock" when using real routers only).
COMPOSE_PROFILES=mock
# Optional: Prisma (gRPC address) registered on first start. Add the others through the UI.
PRISMA_API_URL=http://prisma-mock:50051

# Certificates of the real Prismas (mTLS): host directory mounted read-only in the back end.
# Each subdirectory is a profile: ca.crt + <name>.crt + <name>.key. Never inside the repository.
PRISMA_TLS_DIR=/etc/prisma-web
# Group that owns the certificate files (the key usually has mode 0640).
PRISMA_TLS_GID=1000

SESSION_TTL_HOURS=12
# Set to true when access is over HTTPS.
COOKIE_SECURE=false
